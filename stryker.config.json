{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "plugins": ["@stryker-mutator/tap-runner"],
  "tap": {
    "testFiles": ["src/**/*.test.ts"]
  },
  "mutate": ["src/*.ts", "!src/*.test.ts", "!src/background.ts", "!src/newtab.ts", "!src/theme.ts", "!src/theme-key.ts"],
  "ignorePatterns": ["tsconfig.json", "dist", "e2e", "*.local*", "default-demo-sparks.json5"],
  "reporters": ["clear-text", "html", "json", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 90
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
