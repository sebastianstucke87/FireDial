{
  "manifest_version": 3,
  "name": "FireDial",
  "description": "Minimal speed dial for your bookmarks! Completely free and open source: no ads, no account, no tracking, no BS.",
  "homepage_url": "https://github.com/sebastianstucke87/FireDial",
  "browser_specific_settings": {
    "gecko": {
      "id": "firedial@sebastianstucke87.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["js/background.js"],
    "type": "module"
  },
  "permissions": ["activeTab", "bookmarks", "downloads", "menus", "scripting", "search", "storage", "unlimitedStorage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
